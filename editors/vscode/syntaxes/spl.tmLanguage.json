{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPL",
  "scopeName": "source.spl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.spl",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.spl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.spl",
          "match": "\\\\(?:[\\\\\"nrt]|u[0-9A-Fa-f]{4})"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(node|pipeline)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.spl" },
            "2": { "name": "entity.name.type.spl" }
          }
        },
        {
          "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.spl" },
            "2": { "name": "variable.other.definition.spl" },
            "3": { "name": "entity.name.type.spl" }
          }
        },
        {
          "match": "\\b(impl)\\s+(python|javascript|typescript|cpp|rust)\\b",
          "captures": {
            "1": { "name": "keyword.control.spl" },
            "2": { "name": "entity.name.namespace.spl" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.spl",
          "match": "\\b(?:input|output|use|impl|return|if|else|repeat|break)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.spl",
          "match": "\\b(?:Bool|Int64|Float64|String|Bytes|Decimal|List|Map|Optional|Result|Artifact|Stream|Future|Secret)\\b"
        },
        {
          "name": "entity.name.type.spl",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.spl",
          "match": "\\b(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.spl",
          "match": "\\b(?:true|false|null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.spl",
          "match": "(?:->|=>|=|\\+|-|\\*|/|==|!=|<=|>=|<|>)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.parameters.spl",
          "match": "[(),]"
        },
        {
          "name": "punctuation.definition.block.spl",
          "match": "[{}\\[\\]]"
        },
        {
          "name": "punctuation.accessor.spl",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.spl",
          "match": ";"
        }
      ]
    }
  }
}
